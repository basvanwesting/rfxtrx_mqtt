# ~/.config/systemd/user/forest_shuttle.service
# Requires: user in group uucp (serial), `loginctl enable-linger`.
[Unit]
Description=Forest Shuttle curtains (RFXtrx433XL -> MQTT)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=%h/.config/forest_shuttle/env
ExecStart=%h/workspace/forest_shuttle/_build/prod/rel/forest_shuttle/bin/forest_shuttle start
ExecStop=%h/workspace/forest_shuttle/_build/prod/rel/forest_shuttle/bin/forest_shuttle stop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
